# Copy to .env next to docker-compose.yml. .env is git-ignored: it never leaves this PC.
# Keep plain KEY=VALUE lines (no spaces around "=").

# ---- SECRETS: HUMAN ONLY. Set with:  scripts/env.sh secret KEY ----
# Tailscale auth key (reusable, NOT ephemeral) from
# https://login.tailscale.com/admin/settings/keys . Only used for the first login.
TS_AUTHKEY=
POSTGRES_PASSWORD=  #@@DB@@

# ---- non-secret settings (an AI agent may set these with: scripts/env.sh set KEY VALUE) ----
# Your Linux user id (run: id -u). The app container runs as this uid.
APP_UID=1000
# 100.x tailnet IP of the database machine (printed by the DB stack's scripts/up.sh).  #@@DB@@
DB_HOST=  #@@DB@@
POSTGRES_DB=app  #@@DB@@
POSTGRES_USER=app  #@@DB@@
# Spring profiles, comma separated. Add "mtls" to turn on service-to-service mTLS.
SPRING_PROFILES_ACTIVE=
# mTLS (README Part G): want = log-only rollout mode, need = enforce.  #@@MTLS@@
MTLS_CLIENT_AUTH=want  #@@MTLS@@
# Comma-separated service names allowed to call this service over mTLS. Empty = any cert from your CA.  #@@MTLS@@
MTLS_ALLOWED_CLIENTS=  #@@MTLS@@
