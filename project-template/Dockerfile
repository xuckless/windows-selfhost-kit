# syntax=docker/dockerfile:1
# Multi-stage build for a Spring Boot (Maven) app. Generated by windows-selfhost-kit.
# Stage 1 builds the jar with the Maven wrapper; stage 2 is a small JRE image that
# runs it as a non-root user.
ARG JAVA_VERSION=@@JAVA_VERSION@@

FROM eclipse-temurin:${JAVA_VERSION}-jdk AS build
WORKDIR /src
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
# Files committed from Windows may have CRLF line endings or lose the executable bit.
RUN sed -i 's/\r$//' mvnw && chmod +x mvnw
# Download dependencies in their own layer so code changes rebuild faster.
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -ntp -q dependency:go-offline || true
COPY src/ src/
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -ntp -DskipTests package
RUN mkdir -p /out \
 && jars="$(find target -maxdepth 1 -name '*.jar' ! -name '*-plain.jar' ! -name '*-sources.jar' ! -name '*-javadoc.jar')" \
 && if [ "$(printf '%s\n' "$jars" | grep -c .)" != 1 ]; then \
      echo "Expected exactly one runnable jar in target/, found: $jars" >&2; exit 1; fi \
 && cp "$jars" /out/app.jar

FROM eclipse-temurin:${JAVA_VERSION}-jre
# APP_UID must match your Linux user id (id -u) so the app can read ./certs keys.
ARG APP_UID=1000
ARG GIT_SHA=dev
LABEL org.opencontainers.image.revision=$GIT_SHA
# Ubuntu-based images already have a "ubuntu" user with uid 1000: remove it first.
RUN (userdel -r ubuntu 2>/dev/null || true) \
 && (grp="$(getent group "${APP_UID}" | cut -d: -f1)"; [ -z "$grp" ] || groupdel "$grp" || true) \
 && groupadd --gid "${APP_UID}" app \
 && useradd --uid "${APP_UID}" --gid app --no-create-home --home-dir /app --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=build --chown=app:app /out/app.jar /app/app.jar
USER app
ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"
# "exec" makes java PID 1 so it receives the stop signal and shuts down cleanly.
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
