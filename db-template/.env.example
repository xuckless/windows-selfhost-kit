# Copy to .env (scripts/env.sh does it for you). .env never leaves this PC.

# ---- SECRETS: HUMAN ONLY. Set with:  scripts/env.sh secret KEY ----
# Tailscale auth key (reusable, NOT ephemeral): https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# Database password. Easiest: scripts/env.sh secret POSTGRES_PASSWORD --generate
POSTGRES_PASSWORD=

# ---- non-secret settings ----
POSTGRES_DB=app
POSTGRES_USER=app
